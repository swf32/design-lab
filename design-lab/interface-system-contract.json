        "EmptyState",
        "IconButton",
        "ModuleHeader",
        "ModuleId",
        "ModulePage",
        "PlaygroundControlsRail",
        "RadioButton",
        "RuntimeFrameSurface",
        "Slider",
        "StoryCanvas",
        "TabSwitcher",
        "Table",
        "TableColumn",
        "TypedPlaygroundControls",
        "USER_FLOW_NODE_GAP",
        "USER_FLOW_NODE_WIDTH",
        "UserFlowCanvas",
        "UserFlowCanvasEdge",
        "UserFlowCanvasNode",
        "UserFlowCanvasViewState",
        "WireframeCard",
        "WireframeDevPanel",
        "WireframeScreenPreview",
        "WorkbenchAction",
        "WorkbenchInspector",
        "WorkbenchPlayground"
      ]
    },
    "icons": {
      "import": "@design-lab/system/icons",
      "requiredExports": [
        "ArrowLeftIcon",
        "CardsViewIcon",
        "CodeIcon",
        "CopyIcon",
        "DarkThemeIcon",
        "DirectoryIcon",
        "LightThemeIcon",
        "LinkIcon",
        "ListViewIcon",
        "SettingsIcon",
        "StarIcon"
      ]
    },
