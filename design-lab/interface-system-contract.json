      "import": "@design-lab/system/i18n",
      "requiredExports": ["DesignLabI18nProvider", "MessageKey", "useDesignLabI18n"]
    },
    "inspection": {
      "import": "@design-lab/system/inspection",
      "requiredExports": ["InspectionBoundary", "InspectionHost"]
    },
    "playground": {
      "import": "@design-lab/system/playground",
      "requiredExports": [
        "ComponentPlaygroundModule",
        "PlaygroundControl",
        "PlaygroundControls",
        "PlaygroundValues"
      ]
    },
    "pages": {
      "import": "@design-lab/system/pages",
