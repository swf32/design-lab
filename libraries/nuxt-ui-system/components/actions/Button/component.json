{
  "id": "nuxt-button",
  "name": "Nuxt Button",
  "description": "A product action wrapper powered by the real Nuxt UI UButton implementation.",
  "aliases": ["Vue button", "UButton", "Nuxt action"],
  "useWhen": ["build a Vue action", "prove Nuxt UI integration", "submit or confirm an action"],
  "avoidWhen": ["display passive status", "navigate with an unstyled text link"],
  "entry": "Button.vue",
  "preview": "Button.preview.vue",
  "stories": "Button.stories.json",
  "playground": "Button.playground.json",
  "docs": "README.md",
  "changelog": "CHANGELOG.md",
  "status": "ready",
  "technology": "vue",
  "adapter": "vue-sfc",
  "states": ["default", "hover", "focus", "disabled", "loading"],
  "variants": ["primary", "secondary", "soft", "ghost"],
  "props": {
    "label": { "type": "string", "default": "Continue" },
    "variant": {
      "type": "enum",
      "values": ["primary", "secondary", "soft", "ghost"],
      "default": "primary"
    },
    "size": {
      "type": "enum",
      "values": ["small", "medium", "large"],
      "default": "medium"
    },
    "disabled": { "type": "boolean", "default": false },
    "loading": { "type": "boolean", "default": false }
  },
  "events": {
    "click": { "description": "Emitted after an enabled action is activated." }
  }
}
