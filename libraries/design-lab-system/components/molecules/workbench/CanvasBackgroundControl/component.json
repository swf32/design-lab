{
  "id": "canvas-background-control",
  "name": "Canvas Background Control",
  "description": "Separately controls the shared Workbench canvas background and the active design-system theme discovered from source tokens.",
  "aliases": ["canvas mode control", "story background selector", "preview background"],
  "useWhen": [
    "change every workbench canvas background",
    "inspect a component on light or dark grid",
    "set a custom story surface color",
    "switch among arbitrary themes declared by the active design system"
  ],
  "avoidWhen": [
    "change the application theme",
    "edit a component color prop",
    "choose a project source"
  ],
  "entry": "CanvasBackgroundControl.tsx",
  "preview": "CanvasBackgroundControl.preview.tsx",
  "stories": "CanvasBackgroundControl.stories.ts",
  "docs": "README.md",
  "changelog": "CHANGELOG.md",
  "status": "ready",
  "previewMotion": {
    "trigger": "card-hover-focus",
    "kind": "reveal",
    "durationToken": "transition.preview",
    "easingToken": "easing.preview",
    "reducedMotion": "static-baseline"
  },
  "states": [
    "collapsed",
    "expanded",
    "dark-grid",
    "light-grid",
    "solid",
    "solid-picker-open",
    "source-themes"
  ],
  "variants": ["default"],
  "props": {
    "mode": {
      "type": "CanvasMode",
      "required": true,
      "values": ["dark-grid", "light-grid", "solid"]
    },
    "color": {
      "type": "string",
      "required": true
    },
    "onModeChange": {
      "type": "(mode: CanvasMode) => void",
      "required": true
    },
    "onColorChange": {
      "type": "(color: string) => void",
      "required": true
    },
    "themes": {
      "type": "string[]"
    },
    "theme": {
      "type": "string"
    },
    "onThemeChange": {
      "type": "(theme: string) => void"
    }
  }
}
