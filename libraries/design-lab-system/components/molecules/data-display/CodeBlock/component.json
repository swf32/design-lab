{
  "id": "code-block",
  "name": "Code Block",
  "description": "Displays copyable multiline source code with preserved whitespace, a language label, and horizontal overflow.",
  "aliases": ["source block", "code snippet", "fenced code", "copy code"],
  "useWhen": [
    "show an import statement",
    "document source code",
    "let users copy a multiline snippet"
  ],
  "avoidWhen": ["show a short inline identifier", "edit code", "render prose documentation"],
  "entry": "CodeBlock.tsx",
  "preview": "CodeBlock.preview.tsx",
  "stories": "CodeBlock.stories.ts",
  "docs": "README.md",
  "changelog": "CHANGELOG.md",
  "status": "ready",
  "previewMotion": {
    "trigger": "card-hover-focus",
    "kind": "state-transition",
    "durationToken": "transition.preview",
    "easingToken": "easing.preview",
    "reducedMotion": "static-baseline"
  },
  "variants": ["default", "code-only"],
  "states": ["ready", "copied", "collapsed", "expanded", "overflow"],
  "props": {
    "code": {
      "type": "string",
      "required": true
    },
    "language": {
      "type": "string",
      "default": "text"
    },
    "variant": {
      "type": "'default' | 'code-only'",
      "default": "default"
    },
    "showCopy": {
      "type": "boolean",
      "default": true
    },
    "copyOnClick": {
      "type": "boolean",
      "default": false
    },
    "collapsedLines": {
      "type": "number"
    }
  }
}
